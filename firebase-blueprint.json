{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a user in the system (Admin, Franchise, Teacher, Student)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMINISTRATOR", "ADMIN", "FRANCHISE", "TEACHER", "STUDENT"] },
        "avatar": { "type": "string" },
        "franchiseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "BusinessProfile": {
      "title": "Business Profile",
      "description": "Global institutional settings and public info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "logoUrl": { "type": "string" },
        "mission": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "duration": { "type": "string" },
        "level": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["id", "title", "category"]
    },
    "Franchise": {
      "title": "Franchise",
      "description": "Study center details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "walletBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "BLOCKED"] }
      },
      "required": ["id", "name", "ownerId", "status"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enrollmentNo": { "type": "string" },
        "name": { "type": "string" },
        "franchiseId": { "type": "string" },
        "course": { "type": "string" },
        "feeStatus": { "type": "string", "enum": ["PAID", "PARTIAL", "PENDING"] }
      },
      "required": ["id", "enrollmentNo", "name", "franchiseId"]
    },
    "FeePayment": {
      "title": "Fee Payment",
      "description": "A payment record for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "receiptNo": { "type": "string" },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["id", "studentId", "receiptNo", "paidAmount"]
    },
    "WalletTransaction": {
      "title": "Wallet Transaction",
      "description": "Credit/Debit logs for franchise wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "franchiseId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["CREDIT", "DEBIT"] },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "PENDING"] }
      },
      "required": ["id", "franchiseId", "amount", "type"]
    },
    "AdmissionEnquiry": {
      "title": "Admission Enquiry",
      "description": "A lead or enquiry from the website",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "course": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "FOLLOWED_UP", "ENROLLED", "CLOSED"] }
      },
      "required": ["id", "name", "phone"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles collection"
    },
    "business_profile": {
      "schema": "BusinessProfile",
      "description": "Global institutional settings"
    },
    "courses": {
      "schema": "Course",
      "description": "Course catalog"
    },
    "franchises": {
      "schema": "Franchise",
      "description": "Franchise centers"
    },
    "students": {
      "schema": "Student",
      "description": "Student records"
    },
    "fee_payments": {
      "schema": "FeePayment",
      "description": "Payment history"
    },
    "wallet_transactions": {
      "schema": "WalletTransaction",
      "description": "Franchise wallet transactions"
    },
    "enquiries": {
      "schema": "AdmissionEnquiry",
      "description": "Leads and enquiries"
    }
  }
}
