rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMINISTRATOR'
      );
    }
    
    function isFranchise() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'FRANCHISE';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    // Business Profile
    match /business_profile/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses
    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Franchises
    match /franchises/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isFranchise() && resource.data.ownerId == request.auth.uid);
      allow create: if isAdmin() || isFranchise();
    }

    // Students
    match /students/{id} {
      allow read: if isAdmin() || isFranchise() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || isFranchise();
    }

    // Fee Payments
    match /fee_payments/{id} {
      allow read: if isAdmin() || isFranchise();
      allow write: if isAdmin() || isFranchise();
    }

    // Wallet Transactions
    match /wallet_transactions/{id} {
      allow read: if isAdmin() || isFranchise();
      allow write: if isAdmin() || isFranchise();
    }

    // Enquiries
    match /enquiries/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
  }
}
